# MySQL数据库配置
MYSQL_ROOT_PASSWORD=stock_root_2024
MYSQL_DATABASE=stock_data
MYSQL_USER=stock_user
MYSQL_PASSWORD=stock_pass_2024

# Redis配置
REDIS_URL=redis://redis:6379/0

# Flask后端配置
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=your-secret-key-here

# 数据库连接字符串
DATABASE_URL=mysql+pymysql://stock_user:stock_pass_2024@mysql:3306/stock_data

# 前端配置
REACT_APP_API_URL=http://localhost/api
REACT_APP_ENV=production

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# 定时任务配置
JOB_ENABLED=true
JOB_LOG_LEVEL=INFO

# 股票API配置
TUSHARE_TOKEN=your-tushare-token-here
EASTMONEY_API_URL=https://push2.eastmoney.com/api/qt/stock/get
